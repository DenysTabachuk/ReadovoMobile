{
  "scripts": {
    "prepare": "node scripts/setup-git.cjs && husky",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "check:staged": "lint-staged --hide-all",
    "ci": "npm run ci:backend && npm run ci:frontend",
    "ci:backend": "npm --prefix backend run ci",
    "ci:frontend": "npm --prefix frontend run ci",
    "frontend:start:local": "npm --prefix frontend run start:local",
    "frontend:start:render": "npm --prefix frontend run start:render",
    "frontend:start:android:local": "npm --prefix frontend run start:android:local",
    "frontend:start:android:render": "npm --prefix frontend run start:android:render",
    "android:local": "npm --prefix frontend run android:local",
    "android:render": "npm --prefix frontend run android:render",
    "mock:api": "json-server --watch mock-api/db.json --host 0.0.0.0 --port 3101 --routes mock-api/routes.json --middlewares mock-api/server.js",
    "db:down": "docker compose down",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:up": "docker compose up -d postgres"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "json-server": "^0.17.4",
    "lint-staged": "^17.6.0"
  },
  "dependencies": {
    "i18next": "^26.0.6",
    "react-i18next": "^17.0.4"
  }
}
