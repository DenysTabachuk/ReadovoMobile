{
  "scripts": {
    "contracts:generate": "npm --prefix backend run openapi:generate && npm --prefix frontend run api-types:generate",
    "contracts:check": "npm --prefix backend run openapi:check && npm --prefix frontend run api-types:check",
    "prepare": "node scripts/setup-git.cjs && husky",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "check:staged": "lint-staged --hide-all --max-arg-length 6000",
    "ci": "npm run format:check && npm run ci:backend && npm run ci:frontend && npm run audit:unused",
    "format:check": "prettier --check --end-of-line auto .github/workflows/ci.yml \"package{,-lock}.json\" knip.jsonc lint-staged.config.mjs",
    "format:staged": "prettier --write --end-of-line auto",
    "ci:backend": "npm --prefix backend run ci",
    "ci:frontend": "npm --prefix frontend run ci",
    "frontend:start:local": "npm --prefix frontend run start:local",
    "frontend:start:render": "npm --prefix frontend run start:render",
    "frontend:start:android:local": "npm --prefix frontend run start:android:local",
    "frontend:start:android:render": "npm --prefix frontend run start:android:render",
    "android:local": "npm --prefix frontend run android:local",
    "android:render": "npm --prefix frontend run android:render",
    "db:down": "docker compose down",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:up": "docker compose up -d postgres",
    "audit:unused": "knip --config knip.jsonc",
    "audit:unused:backend": "knip --config knip.jsonc --workspace backend --workspace \"!.\"",
    "audit:unused:frontend": "knip --config knip.jsonc --workspace frontend --workspace \"!.\"",
    "audit:unused:root": "knip --config knip.jsonc --workspace . --workspace \"!frontend\" --workspace \"!backend\""
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10"
  }
}
