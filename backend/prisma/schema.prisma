generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum DictionaryWordProgress {
  new
  in_progress
  learned

  @@map("dictionary_word_progress")
}

enum StreakDayStatus {
  completed
  missed
  frozen
  restored

  @@map("streak_day_status")
}

enum VocabularyLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("vocabulary_level")
}

enum VocabularyStageKind {
  learn
  practice

  @@map("vocabulary_stage_kind")
}

enum VocabularyExerciseKind {
  word_to_picture
  audio_to_picture
  sentence_gap

  @@map("vocabulary_exercise_kind")
}

// Catalogue identity is independent of the English level of its lesson variants.
model LearningTopic {
  id                String                     @id @db.Uuid
  slug              String                     @unique
  coverImageKey     String?                    @map("cover_image_key")
  thumbnailImageKey String?                    @map("thumbnail_image_key")
  parentId          String?                    @map("parent_id") @db.Uuid
  position          Int
  publishedAt       DateTime?                  @map("published_at") @db.Timestamptz(6)
  parent            LearningTopic?             @relation("TopicChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children          LearningTopic[]            @relation("TopicChildren")
  translations      LearningTopicTranslation[]
  lessons           LearningLesson[]

  @@index([parentId, position])
  @@map("learning_topics")
}

model LearningTopicTranslation {
  topicId     String        @map("topic_id") @db.Uuid
  locale      String
  title       String
  description String
  topic       LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([topicId, locale])
  @@map("learning_topic_translations")
}

model LearningLesson {
  id                String                      @id @db.Uuid
  slug              String                      @unique
  thumbnailImageKey String?                     @map("thumbnail_image_key")
  readingImageKey   String?                     @map("reading_image_key")
  resultsImageKey   String?                     @map("results_image_key")
  topicId           String                      @map("topic_id") @db.Uuid
  position          Int
  topic             LearningTopic               @relation(fields: [topicId], references: [id], onDelete: Restrict)
  translations      LearningLessonTranslation[]
  variants          LearningLessonVariant[]

  @@index([topicId, position])
  @@map("learning_lessons")
}

model LearningLessonTranslation {
  lessonId    String         @map("lesson_id") @db.Uuid
  locale      String
  title       String
  description String
  lesson      LearningLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, locale])
  @@map("learning_lesson_translations")
}

model LearningLessonVariant {
  lessonId          String                    @map("lesson_id") @db.Uuid
  level             VocabularyLevel
  id                String                    @unique @db.Uuid
  publishedAt       DateTime?                 @map("published_at") @db.Timestamptz(6)
  readingTitle      String                    @map("reading_title")
  readingParagraphs String[]                  @map("reading_paragraphs")
  lesson            LearningLesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  vocabularyWords   VocabularyLessonWord[]
  vocabularyStages  VocabularyLessonStage[]
  questions         LearningReadingQuestion[]

  @@id([lessonId, level])
  @@map("learning_lesson_variants")
}

model LearningReadingQuestion {
  lessonId    String                  @map("lesson_id") @db.Uuid
  level       VocabularyLevel
  id          String
  position    Int
  prompt      String
  explanation String
  variant     LearningLessonVariant   @relation(fields: [lessonId, level], references: [lessonId, level], onDelete: Cascade)
  options     LearningReadingOption[]

  @@id([lessonId, level, id])
  @@unique([lessonId, level, position])
  @@map("learning_reading_questions")
}

model LearningReadingOption {
  lessonId   String                  @map("lesson_id") @db.Uuid
  level      VocabularyLevel
  questionId String                  @map("question_id")
  id         String
  position   Int
  text       String
  isCorrect  Boolean                 @map("is_correct")
  question   LearningReadingQuestion @relation(fields: [lessonId, level, questionId], references: [lessonId, level, id], onDelete: Cascade)

  @@id([lessonId, level, questionId, id])
  @@unique([lessonId, level, questionId, position])
  @@map("learning_reading_options")
}

// Words belong to lessons, independently of the user's personal dictionary.
model VocabularyLessonWord {
  variantId            String                     @map("variant_id") @db.Uuid
  id                   String
  word                 String
  transcription        String
  translationUk        String                     @map("translation_uk")
  example              String
  exampleTranslationUk String                     @map("example_translation_uk")
  imageKey             String                     @map("image_key")
  imageSourceUrl       String                     @map("image_source_url")
  imageLicense         String                     @map("image_license")
  imageAttribution     String                     @map("image_attribution")
  // Owning lesson; deleting it also deletes this word.
  variant              LearningLessonVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // Stage memberships, including this word's position within each stage.
  stages               VocabularyStageWord[]
  // Exercises where this word is the correct answer.
  exercises            VocabularyExercise[]
  // Answer choices using this word, whether correct or a distractor.
  options              VocabularyExerciseOption[]

  @@id([variantId, id])
  @@map("vocabulary_lesson_words")
}

// Lesson -> stages -> exercises.
// Stages <-> words via VocabularyStageWord; exercises <-> words via VocabularyExerciseOption.
model VocabularyLessonStage {
  variantId    String                       @map("variant_id") @db.Uuid
  id           String
  // Display order within the lesson: 0 = first stage, 1 = second, etc.
  position     Int
  kind         VocabularyStageKind
  variant      LearningLessonVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  translations VocabularyStageTranslation[]
  words        VocabularyStageWord[]
  exercises    VocabularyExercise[]

  @@id([variantId, id])
  @@unique([variantId, position])
  @@map("vocabulary_lesson_stages")
}

// One localized title/description per stage and locale (for example, "en" or "uk").
model VocabularyStageTranslation {
  variantId   String                @map("variant_id") @db.Uuid
  stageId     String                @map("stage_id")
  locale      String
  title       String
  description String
  stage       VocabularyLessonStage @relation(fields: [variantId, stageId], references: [variantId, id], onDelete: Cascade)

  @@id([variantId, stageId, locale])
  @@map("vocabulary_stage_translations")
}

// Many-to-many link: a stage contains words, and a word can appear in several stages.
model VocabularyStageWord {
  variantId String                @map("variant_id") @db.Uuid
  stageId   String                @map("stage_id")
  wordId    String                @map("word_id")
  // Word/card order within this stage: 0 = first word, 1 = second, etc.
  position  Int
  stage     VocabularyLessonStage @relation(fields: [variantId, stageId], references: [variantId, id], onDelete: Cascade)
  word      VocabularyLessonWord  @relation(fields: [variantId, wordId], references: [variantId, id], onDelete: NoAction)

  @@id([variantId, stageId, wordId])
  @@unique([variantId, stageId, position])
  @@index([variantId, wordId])
  @@map("vocabulary_stage_words")
}

// One question in a practice stage, with a correct word and answer choices.
model VocabularyExercise {
  variantId             String                     @map("variant_id") @db.Uuid
  id                    String
  stageId               String                     @map("stage_id")
  // Question order within its stage: 0 = first question, 1 = second, etc.
  position              Int
  kind                  VocabularyExerciseKind
  correctWordId         String                     @map("correct_word_id")
  sentenceBefore        String?                    @map("sentence_before")
  sentenceAfter         String?                    @map("sentence_after")
  sentenceTranslationUk String?                    @map("sentence_translation_uk")
  stage                 VocabularyLessonStage      @relation(fields: [variantId, stageId], references: [variantId, id], onDelete: Cascade)
  correctWord           VocabularyLessonWord       @relation(fields: [variantId, correctWordId], references: [variantId, id], onDelete: NoAction)
  options               VocabularyExerciseOption[]

  @@id([variantId, id])
  @@unique([variantId, stageId, position])
  @@index([variantId, correctWordId])
  @@map("vocabulary_exercises")
}

// Many-to-many link: a question offers words as choices; each word can be reused in other questions.
model VocabularyExerciseOption {
  variantId  String               @map("variant_id") @db.Uuid
  exerciseId String               @map("exercise_id")
  wordId     String               @map("word_id")
  // Choice display order within this question: 0 = first choice, 1 = second, etc.
  position   Int
  exercise   VocabularyExercise   @relation(fields: [variantId, exerciseId], references: [variantId, id], onDelete: Cascade)
  word       VocabularyLessonWord @relation(fields: [variantId, wordId], references: [variantId, id], onDelete: NoAction)

  @@id([variantId, exerciseId, wordId])
  @@unique([variantId, exerciseId, position])
  @@index([variantId, wordId])
  @@map("vocabulary_exercise_options")
}

model User {
  id                  String                         @id @db.Uuid
  email               String                         @unique
  passwordHash        String                         @map("password_hash")
  passwordSalt        String                         @map("password_salt")
  lessonsCompleted    Int                            @default(0) @map("lessons_completed")
  testsCompleted      Int                            @default(0) @map("tests_completed")
  wordsLearned        Int                            @default(0) @map("words_learned")
  balance             Int                            @default(0)
  createdAt           DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  achievements        UserAchievement[]
  dictionaryWords     DictionaryWord[]
  learningDispatches  UserLearningReminderDispatch[]
  mascotProfile       UserMascotProfile?
  notificationProfile UserNotificationPreference?
  pushTokens          UserPushToken[]
  recentArticles      UserRecentArticle[]
  refreshTokens       UserRefreshToken[]
  quizSessions        QuizSession[]
  savedArticles       UserSavedArticle[]
  streakAchievements  UserStreakAchievement[]
  streakHistory       UserStreakHistory[]
  streakProfile       UserStreakProfile?

  @@map("users")
}

model QuizSession {
  id           String       @id @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  kind         String
  level        String?
  targetLength String?      @map("target_length")
  questions    Json
  completion   Json?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime?    @map("completed_at") @db.Timestamptz(6)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      QuizAnswer[]

  @@index([userId, createdAt], map: "quiz_sessions_user_created_idx")
  @@map("quiz_sessions")
}

model QuizAnswer {
  sessionId              String      @map("session_id") @db.Uuid
  questionId             String      @map("question_id")
  selectedOptionIds      String[]    @map("selected_option_ids")
  isCorrect              Boolean     @map("is_correct")
  unlockedAchievementIds String[]    @default([]) @map("unlocked_achievement_ids")
  session                QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, questionId])
  @@map("quiz_answers")
}

model PendingUserRegistration {
  id                    String   @id @db.Uuid
  email                 String   @unique
  passwordHash          String   @map("password_hash")
  passwordSalt          String   @map("password_salt")
  verificationCodeHash  String   @map("verification_code_hash")
  verificationCodeSalt  String   @map("verification_code_salt")
  verificationExpiresAt DateTime @map("verification_expires_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pending_user_registrations")
}

model PasswordResetRequest {
  id                    String    @id @db.Uuid
  email                 String    @unique
  verificationCodeHash  String    @map("verification_code_hash")
  verificationCodeSalt  String    @map("verification_code_salt")
  verificationExpiresAt DateTime  @map("verification_expires_at") @db.Timestamptz(6)
  resetTokenHash        String?   @map("reset_token_hash")
  resetTokenSalt        String?   @map("reset_token_salt")
  resetTokenExpiresAt   DateTime? @map("reset_token_expires_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("password_reset_requests")
}

model UserRefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  tokenSalt String    @map("token_salt")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, expiresAt(sort: Desc)], map: "user_refresh_tokens_user_active_idx")
  @@map("user_refresh_tokens")
}

model UserAchievement {
  userId        String    @map("user_id") @db.Uuid
  achievementId String    @map("achievement_id")
  unlockedAt    DateTime  @default(now()) @map("unlocked_at") @db.Timestamptz(6)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model UserMascotProfile {
  userId             String   @id @map("user_id") @db.Uuid
  equippedHeadItemId String?  @map("equipped_head_item_id")
  equippedEyesItemId String?  @map("equipped_eyes_item_id")
  equippedGlassesId  String?  @map("equipped_glasses_id")
  equippedHatId      String?  @map("equipped_hat_id")
  equippedBandanaId  String?  @map("equipped_bandana_id")
  equippedEyePatchId String?  @map("equipped_eye_patch_id")
  ownedItemIds       String[] @default([]) @map("owned_item_ids")
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_mascot_profiles")
}

model ArticleSimplification {
  cacheKey       String   @id @map("cache_key")
  articleId      Int?     @map("article_id")
  title          String
  level          String
  targetLength   String   @map("target_length")
  targetPercent  Int?     @map("target_percent")
  sourceHash     String?  @map("source_hash")
  originalLength Int      @map("original_length")
  adaptedText    String?  @map("adapted_text")
  adaptedBlocks  Json?    @map("adapted_blocks")
  questions      Json?
  adaptedLength  Int      @map("adapted_length")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([articleId], map: "article_simplifications_article_id_idx")
  @@map("article_simplifications")
}

model ArticleTransformationChunk {
  cacheKey      String   @id @map("cache_key")
  adaptedBlocks Json     @map("adapted_blocks")
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "article_transformation_chunks_expires_at_idx")
  @@map("article_transformation_chunks")
}

model UserSavedArticle {
  userId       String   @map("user_id") @db.Uuid
  articleId    Int      @map("article_id")
  title        String
  extract      String
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  savedAt      DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, articleId])
  @@index([userId, savedAt(sort: Desc)], map: "user_saved_articles_user_saved_at_idx")
  @@map("user_saved_articles")
}

model UserRecentArticle {
  userId       String   @map("user_id") @db.Uuid
  articleId    Int      @map("article_id")
  title        String
  extract      String
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  openedAt     DateTime @default(now()) @map("opened_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, articleId])
  @@index([userId, openedAt(sort: Desc)], map: "user_recent_articles_user_opened_at_idx")
  @@map("user_recent_articles")
}

model DictionaryWord {
  id                  String                 @id @db.Uuid
  userId              String?                @map("user_id") @db.Uuid
  word                String
  normalizedWord      String                 @map("normalized_word")
  translation         String
  context             String
  progress            DictionaryWordProgress @default(new)
  lastReviewedAt      DateTime?              @map("last_reviewed_at") @db.Timestamptz(6)
  correctAnswersCount Int                    @default(0) @map("correct_answers_count")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user                User?                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, normalizedWord], map: "dictionary_words_user_id_normalized_word_idx")
  @@index([userId, createdAt(sort: Desc)], map: "dictionary_words_user_id_created_at_idx")
  @@map("dictionary_words")
}

model UserStreakProfile {
  userId           String    @id @map("user_id") @db.Uuid
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date") @db.Date
  freezeTokens     Int       @default(1) @map("freeze_tokens")
  timezone         String    @default("UTC")
  brokenStreakInfo Json?     @map("broken_streak_info")
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_streak_profiles")
}

model UserStreakHistory {
  userId       String          @map("user_id") @db.Uuid
  activityDate DateTime        @map("activity_date") @db.Date
  status       StreakDayStatus
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, activityDate])
  @@index([userId, activityDate(sort: Desc)], map: "user_streak_history_user_date_idx")
  @@map("user_streak_history")
}

model UserStreakAchievement {
  userId      String   @map("user_id") @db.Uuid
  milestone   Int
  rewardCoins Int      @map("reward_coins")
  claimedAt   DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, milestone])
  @@map("user_streak_achievements")
}

model UserNotificationPreference {
  userId                   String   @id @map("user_id") @db.Uuid
  learningRemindersEnabled Boolean  @default(false) @map("learning_reminders_enabled")
  learningReminderTime     String   @default("19:00") @map("learning_reminder_time")
  updatedAt                DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_notification_preferences")
}

model UserPushToken {
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id")
  pushToken  String?  @unique(map: "user_push_tokens_push_token_idx") @map("push_token")
  provider   String   @default("fcm")
  platform   String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, deviceId])
  @@map("user_push_tokens")
}

model UserLearningReminderDispatch {
  userId       String   @map("user_id") @db.Uuid
  reminderDate DateTime @map("reminder_date") @db.Date
  sentAt       DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, reminderDate])
  @@map("user_learning_reminder_dispatches")
}
